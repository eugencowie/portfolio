---
import { Font } from "astro:assets";
import "@/styles/global.css";

const fontPreload = [{ weight: 400, style: "normal", subset: "latin" }];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <slot name="head" />
    <Font cssVariable="--font-commit-mono" preload={fontPreload} />
    <Font cssVariable="--font-anton" preload={fontPreload} />
    <Font cssVariable="--font-yellowtail" preload={fontPreload} />
  </head>
  <body class="min-h-svh">
    <slot />
  </body>
</html>
