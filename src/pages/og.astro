---
// Rendered to public/og.png by `mise run build:assets`. Not indexed: it exists only to be screenshotted.
import BaseLayout from "@/layouts/BaseLayout.astro";
import Identity from "@/components/Identity.astro";
import Skyline from "@/components/Skyline.astro";

/** The Identity is about 1.4 times as tall as the Avatar is wide, so 24rem
 * fills the 630px frame with a margin above the hair and below `codes`. */
const avatarWidth = "24rem";
---

<BaseLayout>
  <Fragment slot="head">
    <meta name="robots" content="noindex" />
  </Fragment>
  <Skyline />
  {/* Padded at the bottom to lift the Identity a touch above centre, so
      `codes` clears the brightest rooftops. */}
  <div class="relative flex h-[630px] w-[1200px] items-center overflow-hidden pb-12">
    <Identity avatarWidth={avatarWidth} />
  </div>
</BaseLayout>
