---
// Rendered to public/og.png by `mise run build:assets`. Not indexed: it exists only to be screenshotted.
import { Image } from "astro:assets";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Wordmark from "@/components/Wordmark.astro";
import avatar from "@/assets/avatar.png";
import { socialLinks } from "@/site";
---

<BaseLayout>
  <Fragment slot="head">
    <meta name="robots" content="noindex" />
  </Fragment>
  <div class="relative flex h-[630px] w-[1200px] items-center justify-center gap-16 overflow-hidden">
    <div
      aria-hidden="true"
      class="pointer-events-none absolute inset-0 blur-3xl"
      style="background: radial-gradient(circle at 35% 50%, color-mix(in oklab, var(--magenta) 22%, transparent), transparent 45%), radial-gradient(circle at 60% 50%, color-mix(in oklab, var(--cyan) 22%, transparent), transparent 45%);"
    />
    <Image src={avatar} alt="" width={480} class="relative size-[440px]" />
    <div class="relative flex flex-col gap-16">
      <Wordmark class="text-8xl" />
      <p class="mt-4 text-2xl text-muted">
        {socialLinks.map((link) => (
          <span class="block">{link.printLabel}</span>
        ))}
      </p>
    </div>
  </div>
</BaseLayout>
