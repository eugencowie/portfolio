---
/**
 * The starry night behind every page, pinned to the viewport: indigo overhead
 * deepening to purple at the bottom, with stars thinning out towards it. The
 * Skyline stands in front of it in the Hero and dissolves into it, so the rest
 * of the page scrolls over plain sky. Star positions are drawn once at build
 * time from a fixed seed so every build renders the same sky, and are laid out
 * in viewport units so they spread over any screen.
 */
function seededRandom(seed: number) {
  return () => {
    seed = (seed + 0x6d2b79f5) | 0;
    let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

const random = seededRandom(20260920);
const percent = () => (random() * 100).toFixed(2);

// Three layers of different sizes twinkle out of step with one another.
const layers = [
  { count: 140, size: 1, period: "5s" },
  { count: 60, size: 1.5, period: "7s" },
  { count: 22, size: 2.2, period: "11s" },
].map((layer) => ({
  ...layer,
  shadow: Array.from({ length: layer.count }, () => {
    const alpha = (0.5 + random() * 0.5).toFixed(2);
    return `${percent()}vw ${percent()}vh 0 0 hsl(0 0% 100% / ${alpha})`;
  }).join(", "),
}));
---

<div
  aria-hidden="true"
  class="sky pointer-events-none fixed inset-0 -z-10 select-none"
>
  <div class="sky-stars absolute inset-0">
    {layers.map(({ size, period, shadow }) => (
      <span
        class="star absolute top-0 left-0 rounded-full"
        style={`--size: ${size}px; --period: ${period}; box-shadow: ${shadow}`}
      />
    ))}
  </div>
</div>

<style>
  .sky {
    background: linear-gradient(
      to bottom,
      #0d0c2c 0%,
      #15123f 40%,
      #27155e 78%,
      #451a74 100%
    );
  }
  /* Stars thin out and vanish towards the bottom of the screen. */
  .sky-stars {
    mask-image: linear-gradient(to bottom, black 35%, transparent 88%);
  }
  .star {
    width: var(--size);
    height: var(--size);
    animation: twinkle var(--period) ease-in-out infinite alternate;
  }
  @keyframes twinkle {
    from {
      opacity: 0.55;
    }
    to {
      opacity: 1;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .star {
      animation: none;
    }
  }
</style>
