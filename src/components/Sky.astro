---
import { seededRandom } from "@/lib/random";

/**
 * The starry night behind every page, fixed to the screen so the stars stay
 * put as the page scrolls: indigo overhead deepening to purple at the foot of
 * the screen, with stars thinning out towards it, where the Skyline stands in
 * front of them in the Hero and dissolves into it. For visitors who prefer
 * reduced motion, and in browsers without scroll-driven animations, where the
 * Skyline scrolls away with the Hero, the Sky spans the whole document and
 * scrolls with it instead: just below the fold the purple recedes through the
 * same shades in reverse, a short band of sky mirrored in the river, and
 * reaches the plain page background around the Highrise's roof. Fixed, the
 * Sky is as tall as the largest viewport, so on a phone whose toolbar has
 * collapsed the head of that band shows beneath the Skyline's foot. Star
 * positions are drawn once at build time from a fixed seed so every build
 * renders the same sky, and are laid out in viewport units so they spread
 * over any screen. The `<body>` is `relative` so the Sky can stretch to the
 * full page height.
 */

const random = seededRandom(20260920);
const percent = () => (random() * 100).toFixed(2);

// Three layers of different sizes twinkle out of step with one another.
const layers = [
  { count: 140, size: 1, period: "5s" },
  { count: 60, size: 1.5, period: "7s" },
  { count: 22, size: 2.2, period: "11s" },
].map((layer) => ({
  ...layer,
  shadow: Array.from({ length: layer.count }, () => {
    const alpha = (0.5 + random() * 0.5).toFixed(2);
    return `${percent()}vw ${percent()}vh 0 0 hsl(0 0% 100% / ${alpha})`;
  }).join(", "),
}));
---

<div
  aria-hidden="true"
  class="sky pointer-events-none absolute inset-0 -z-10 select-none"
>
  <div class="sky-stars absolute inset-x-0 top-0 h-svh">
    {layers.map(({ size, period, shadow }) => (
      <span
        class="star absolute top-0 left-0 rounded-full"
        style={`--size: ${size}px; --period: ${period}; box-shadow: ${shadow}`}
      />
    ))}
  </div>
</div>

<style>
  /* Sky over the first screen, a band of reflection below it, page after. */
  .sky {
    background: linear-gradient(
      to bottom,
      #0d0c2c 0,
      #15123f 40svh,
      #27155e 78svh,
      #451a74 100svh,
      #27155e 106svh,
      #15123f 112svh,
      var(--background) 120svh
    );
  }
  /* Fixed wherever the Skyline is held (see Skyline.astro). */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: scroll()) {
      .sky {
        position: fixed;
        bottom: auto;
        height: 100lvh;
      }
    }
  }
  /* Stars thin out and vanish towards the bottom of the first screen. */
  .sky-stars {
    mask-image: linear-gradient(to bottom, black 35%, transparent 88%);
  }
  .star {
    width: var(--size);
    height: var(--size);
    animation: twinkle var(--period) ease-in-out infinite alternate;
  }
  @keyframes twinkle {
    from {
      opacity: 0.55;
    }
    to {
      opacity: 1;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .star {
      animation: none;
    }
  }
</style>
