---
/**
 * The starry night behind every page, spanning the whole document and
 * scrolling with it. The first screen is the sky proper: indigo overhead
 * deepening to purple at the fold, with stars thinning out towards it, where
 * the Skyline stands in front of them in the Hero and dissolves into it.
 * Below the fold the purple recedes through the same shades in reverse over
 * the next screen, the sky mirrored in the river, and the rest of the page
 * scrolls over the plain page background. Star positions are drawn once at
 * build time from a fixed seed so every build renders the same sky, and are
 * laid out in viewport units so they spread over any screen. The `<body>` is
 * `relative` so the Sky stretches to the full page height.
 */
function seededRandom(seed: number) {
  return () => {
    seed = (seed + 0x6d2b79f5) | 0;
    let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

const random = seededRandom(20260920);
const percent = () => (random() * 100).toFixed(2);

// Three layers of different sizes twinkle out of step with one another.
const layers = [
  { count: 140, size: 1, period: "5s" },
  { count: 60, size: 1.5, period: "7s" },
  { count: 22, size: 2.2, period: "11s" },
].map((layer) => ({
  ...layer,
  shadow: Array.from({ length: layer.count }, () => {
    const alpha = (0.5 + random() * 0.5).toFixed(2);
    return `${percent()}vw ${percent()}vh 0 0 hsl(0 0% 100% / ${alpha})`;
  }).join(", "),
}));
---

<div
  aria-hidden="true"
  class="sky pointer-events-none absolute inset-0 -z-10 select-none"
>
  <div class="sky-stars absolute inset-x-0 top-0 h-svh">
    {layers.map(({ size, period, shadow }) => (
      <span
        class="star absolute top-0 left-0 rounded-full"
        style={`--size: ${size}px; --period: ${period}; box-shadow: ${shadow}`}
      />
    ))}
  </div>
</div>

<style>
  /* Sky over the first screen, its reflection over the second, page after. */
  .sky {
    background: linear-gradient(
      to bottom,
      #0d0c2c 0,
      #15123f 40svh,
      #27155e 78svh,
      #451a74 100svh,
      #27155e 122svh,
      #15123f 160svh,
      var(--background) 200svh
    );
  }
  /* Stars thin out and vanish towards the bottom of the first screen. */
  .sky-stars {
    mask-image: linear-gradient(to bottom, black 35%, transparent 88%);
  }
  .star {
    width: var(--size);
    height: var(--size);
    animation: twinkle var(--period) ease-in-out infinite alternate;
  }
  @keyframes twinkle {
    from {
      opacity: 0.55;
    }
    to {
      opacity: 1;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .star {
      animation: none;
    }
  }
</style>
