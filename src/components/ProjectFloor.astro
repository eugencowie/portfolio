---
import { Image, getImage } from "astro:assets";
import { ArrowUpRight } from "@lucide/astro";
import type { BalconyKind } from "@/lib/balconies";
import type { FloorProjectEntry } from "@/lib/projects";
import { seededRandom } from "@/lib/random";
import Floor from "./Floor.astro";
import Sign from "./Sign.astro";
import type { Bays } from "./Floor.astro";

/**
 * A Project's floor of the Highrise. Its screenshot fills a lit window, at
 * full brightness all the time, and its light spills onto the bricks around
 * it. Its name hangs beside the window as a Sign, over the tagline and host.
 * The Featured Project's window is wider and arched, with a fanlight lit by
 * the screenshot, on a taller floor. From 64rem the window takes one side
 * and the Sign the other. From 80rem the Featured floor has Piers in place of
 * its Bays, and its window and Sign spread into the room they leave. Its Sign
 * is lit while any part of its Caption is in the middle 30% of the screen's
 * height, or while the Project is focused from the keyboard, wherever the
 * mouse is.
 */
interface Props {
  project: FloorProjectEntry;
  /** Counted from the street up. */
  floor: number;
  side: "left" | "right";
  balcony: BalconyKind;
}
const { project, floor, side, balcony } = Astro.props;
const { name, tagline, href, featured, screenshot } = project.data;

// The end bays' sash windows, a pattern repeating every eight floors.
const BAYS: Bays[] = [
  { left: "lamp", right: "dark" },
  { left: "cat", right: "lamp" },
  { left: "curtain", right: "tv" },
  { left: "dark", right: "blind" },
  { left: "person", right: "dark" },
  { left: "plant", right: "curtain" },
  { left: "tv", right: "dark" },
  { left: "dark", right: "blind" },
];

// A blurred thumbnail is all the Spill and the fanlight's glass need.
const blurred = await getImage({ src: screenshot, width: 160, format: "webp" });
const blurredStyle = `background-image: url(${blurred.src})`;

const random = seededRandom(floor);
const drips = Array.from({ length: 7 }, () => ({
  x: `${(4 + random() * 92).toFixed(1)}%`,
  delay: `${(-random() * 14).toFixed(2)}s`,
  duration: `${(8 + random() * 9).toFixed(2)}s`,
  size: `${(2 + random() * 2.5).toFixed(1)}px`,
}));

// The fanlight's glazing bars, fanning out from the foot of its half-ellipse
// at fractions across its width. Each runs on past the edge, for the glass's
// clip to cut it off flush with the arch.
const bars = [0.08, 0.24, 0.4, 0.5, 0.6, 0.76, 0.92].map((f) => {
  const x = 100 * f - 50;
  const y = 24 * Math.sqrt(1 - (x / 50) ** 2);
  return { x: 50 + x * 1.2, y: 24 - y * 1.2 };
});
---

<Floor
  as="li"
  bays={BAYS[floor % BAYS.length]}
  balcony={balcony}
  ends={featured ? "piers" : "bays"}
  class="project"
  data-attention
  data-window={side}
  data-featured={featured || undefined}
>
  <div class="body">
    <div class="window">
      <div class="window-spill" style={blurredStyle} aria-hidden="true"></div>
      {featured ? (
        <div class="fanlight" data-fanlight aria-hidden="true">
          <div class="fanlight-glass" style={blurredStyle} />
          <svg
            class="fanlight-bars"
            viewBox="0 0 100 24"
            preserveAspectRatio="none"
          >
            {bars.map(({ x, y }) => (
              <line x1="50" y1="24" x2={x} y2={y} />
            ))}
            <path d="M 18 24 A 32 16 0 0 1 82 24" fill="none" />
          </svg>
          <div class="keystone" />
        </div>
      ) : (
        <div class="lintel" aria-hidden="true" />
      )}
      <div class="jambs">
        <div class="pane">
          <Image
            src={screenshot}
            alt={`Screenshot of ${name}`}
            widths={[640, 960, 1280, 1600]}
            sizes="(min-width: 64rem) 50vw, 100vw"
            loading="lazy"
            class="screenshot"
          />
          <div class="sheen" aria-hidden="true"></div>
          <div aria-hidden="true">
            {drips.map((d) => (
              <span
                class="drip"
                style={`--x: ${d.x}; --delay: ${d.delay}; --duration: ${d.duration}; --size: ${d.size}`}
              >
                <span class="drop" />
              </span>
            ))}
          </div>
        </div>
      </div>
      <div class="sill" aria-hidden="true"></div>
    </div>
    <div class="sign-spill" aria-hidden="true"></div>
    <div class="caption" data-caption>
      <h3 class="name">
        <a href={href}>
          <Sign text={name} fit failing={floor % 3 === 1} />
        </a>
      </h3>
      <p class="tagline">{tagline}</p>
      <p class="host">
        {new URL(href).host}
        <ArrowUpRight class="size-4" aria-hidden="true" />
      </p>
    </div>
  </div>
</Floor>

<style>
  @media (min-width: 64rem) {
    .project {
      min-height: clamp(34rem, 76svh, 50rem);
      align-items: center;
    }
    .project[data-featured] {
      min-height: clamp(40rem, 94svh, 60rem);
    }
  }
  /* The window and the Sign. The whole of it is the Project's link. */
  .body {
    position: relative;
    display: grid;
    grid-template-areas: "window" "caption";
    gap: 1.75rem;
    align-items: center;
    border-radius: 0.25rem;
  }
  .body:has(:focus-visible) {
    outline: 2px solid var(--magenta);
    outline-offset: 1rem;
  }
  @media (min-width: 64rem) {
    .body {
      grid-template-columns: minmax(0, 58fr) minmax(0, 42fr);
      grid-template-areas: "window caption";
      gap: clamp(2.5rem, 5vw, 5rem);
    }
    [data-window="right"] .body {
      grid-template-columns: minmax(0, 42fr) minmax(0, 58fr);
      grid-template-areas: "caption window";
    }
    [data-featured] .body {
      grid-template-columns: minmax(0, 62fr) minmax(0, 38fr);
    }
    [data-featured][data-window="right"] .body {
      grid-template-columns: minmax(0, 38fr) minmax(0, 62fr);
    }
  }

  /* ---------- The window: stone head and sill, the screenshot the room ---------- */
  .window {
    grid-area: window;
    position: relative;
  }
  /* A flat arch of three stones. */
  .lintel {
    margin-inline: -0.9rem;
    height: 1.2rem;
    background:
      linear-gradient(
        to right,
        transparent calc(33% - 1px),
        #1a1428 calc(33% - 1px) 33%,
        transparent 33%
      ),
      linear-gradient(
        to right,
        transparent calc(67% - 1px),
        #1a1428 calc(67% - 1px) 67%,
        transparent 67%
      ),
      linear-gradient(
        to bottom,
        var(--stone-edge) 0 1px,
        var(--stone) 1px,
        var(--stone-shade)
      );
    box-shadow: 0 0.35rem 0.6rem rgb(4 2 14 / 0.7);
  }
  .pane {
    position: relative;
    border: 0.5rem solid #110d1c;
    outline: 0.3rem solid #07050e;
    background: #07050e;
    overflow: hidden;
  }
  [data-featured] .pane {
    border-top-width: 0.6rem;
  }
  .screenshot {
    display: block;
    width: 100%;
    height: auto;
  }
  /* The river and the city across it, faint in the glass. */
  .sheen {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      112deg,
      transparent 20%,
      rgb(255 255 255 / 0.07) 28%,
      transparent 34%,
      transparent 70%,
      rgb(255 255 255 / 0.05) 76%,
      transparent 80%
    );
    pointer-events: none;
  }
  /* Rain running down the glass. Each drip's track is the size of the pane,
     so it can slide the drop down by a share of the pane's height. */
  .drip {
    position: absolute;
    inset: 0;
    pointer-events: none;
    animation: drip var(--duration) var(--delay) infinite;
  }
  .drop {
    position: absolute;
    top: 0;
    left: var(--x);
    width: var(--size);
    height: calc(var(--size) * 1.35);
    border-radius: 50% 50% 50% 50% / 40% 40% 60% 60%;
    background: radial-gradient(
      circle at 35% 30%,
      rgb(255 255 255 / 0.85),
      rgb(255 255 255 / 0.15) 60%,
      rgb(255 255 255 / 0.35)
    );
  }
  .drop::before {
    content: "";
    position: absolute;
    bottom: 60%;
    left: 50%;
    width: 1px;
    height: 3.5rem;
    translate: -50% 0;
    background: linear-gradient(to top, rgb(255 255 255 / 0.25), transparent);
  }
  @keyframes drip {
    0% {
      translate: 0 -6%;
    }
    18% {
      translate: 0 8%;
    }
    30% {
      translate: 0 10%;
    }
    52% {
      translate: 0 38%;
    }
    60% {
      translate: 0 40%;
    }
    100% {
      translate: 0 108%;
    }
  }
  .sill {
    position: relative;
    margin-inline: -1.1rem;
    height: 0.95rem;
    /* Its top edge catches the window's light. */
    background: linear-gradient(
      to bottom,
      rgb(255 244 232 / 0.6) 0 2px,
      var(--stone) 2px,
      var(--stone-shade)
    );
    box-shadow: 0 0.7rem 1rem rgb(4 2 14 / 0.75);
  }
  /* Soot run off the sill down the bricks. */
  .sill::after {
    content: "";
    position: absolute;
    top: 100%;
    left: 10%;
    right: 10%;
    height: 7rem;
    background: linear-gradient(to bottom, rgb(6 3 14 / 0.35), transparent);
    mask-image: linear-gradient(
      to right,
      transparent,
      black 20%,
      black 80%,
      transparent
    );
  }
  /* The screenshot's Spill on the bricks, under the brick layer. */
  .window-spill {
    position: absolute;
    z-index: -2;
    inset: -22% -18% -38%;
    background-size: cover;
    background-position: center;
    filter: blur(64px);
    opacity: 0.45;
    pointer-events: none;
  }

  /* ---------- Featured: an arched head with a lit fanlight and a keystone ---------- */
  /* The arch's stone runs on down the jambs, in the shade of its foot. The
     sill reaches past them, its ends tucked behind the quoins, or from 80rem
     resting on the pier. */
  [data-featured] .window {
    --surround: 0.85rem;
    --sill-reach: 1rem;
    --jamb: #2c2542;
  }
  @media (min-width: 64rem) {
    [data-featured] .window {
      --surround: 1.2rem;
      --sill-reach: 1.7rem;
    }
  }
  /* Drawn beside the pane, not as its shadow: a shadow would have the pane
     repainted with every drip that runs down it. */
  [data-featured] .jambs {
    position: relative;
  }
  [data-featured] .jambs::before {
    content: "";
    position: absolute;
    inset: 0 calc(-1 * var(--surround));
    background: var(--jamb);
  }
  [data-featured] .sill {
    margin-inline: calc(-1 * var(--sill-reach));
  }
  .fanlight {
    position: relative;
    aspect-ratio: 100 / 24;
    margin-bottom: -0.5rem;
  }
  .fanlight::before {
    content: "";
    position: absolute;
    inset: calc(-1 * var(--surround)) calc(-1 * var(--surround)) 0;
    clip-path: ellipse(50% 100% at 50% 100%);
    background: linear-gradient(to bottom, #6a5f90, #3d3558 70%, var(--jamb));
  }
  .fanlight-glass {
    position: absolute;
    inset: 0;
    clip-path: ellipse(50% 100% at 50% 100%);
    background-size: cover;
    background-position: center 30%;
    filter: blur(14px) saturate(1.4) brightness(1.35);
  }
  .fanlight-glass::after {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(
      ellipse 60% 100% at 50% 100%,
      rgb(255 236 210 / 0.35),
      transparent
    );
  }
  .fanlight-bars {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    clip-path: ellipse(50% 100% at 50% 100%);
    stroke: #110d1c;
  }
  .fanlight-bars :is(line, path) {
    stroke-width: 5px;
    vector-effect: non-scaling-stroke;
  }
  .keystone {
    position: absolute;
    top: calc(-1 * var(--surround) - 0.5rem);
    left: 50%;
    width: 3rem;
    height: 3.6rem;
    translate: -50% 0;
    clip-path: polygon(0 0, 100% 0, 80% 100%, 20% 100%);
    background: linear-gradient(
      to bottom,
      rgb(230 214 255 / 0.55) 0 2px,
      #6d6294 2px,
      #443b62
    );
  }

  /* ---------- The Sign, its light on the bricks, the tagline and host ---------- */
  .caption {
    grid-area: caption;
    /* A size container, for the Sign to fit to. */
    container-type: inline-size;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  @media (min-width: 64rem) {
    [data-window="right"] .caption {
      align-items: flex-end;
      text-align: right;
    }
    /* Beside the window, the Caption and its Spill are lowered from the
       window's middle to the screenshot's: by as much as the window's head is
       taller than its sill. A percentage is of the Caption's width. */
    .body {
      --lower: calc(1.2rem - 0.95rem);
    }
    /* The fanlight is 24% of the window's width tall, less the 0.5rem the
       pane overlaps it, and the window is 62/38 of the Caption's width. */
    [data-featured] .body {
      --lower: calc(24% * 62 / 38 - 0.5rem - 0.95rem);
    }
    .caption {
      margin-top: var(--lower);
    }
    .sign-spill {
      margin-block: calc(var(--lower) / 2) calc(var(--lower) / -2);
    }
  }
  /* The Sign's largest size; it shrinks to fit the Caption. */
  .name {
    font-size: clamp(1.8rem, 3.1vw, 3.3rem);
  }
  [data-featured] .name {
    font-size: clamp(2.4rem, 4.6vw, 4.8rem);
  }
  .name a:focus-visible {
    outline: none;
  }
  /* The link covers the window and the Sign. */
  .name a::after {
    content: "";
    position: absolute;
    inset: 0;
  }
  /* Laid over the caption's grid area, so it follows the Sign's side. */
  .sign-spill {
    grid-area: caption;
    position: absolute;
    z-index: -2;
    inset: -40% -30%;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.6s ease-out;
    background: radial-gradient(
      closest-side,
      color-mix(in oklab, var(--magenta) 42%, transparent),
      color-mix(in oklab, var(--magenta) 14%, transparent) 55%,
      transparent
    );
  }
  [data-lit] .sign-spill {
    opacity: 1;
    animation: neon-flicker 0.9s linear both;
  }
  .tagline {
    max-width: 34ch;
    font-size: clamp(0.95rem, 1.2vw, 1.1rem);
    line-height: 1.55;
    text-shadow:
      0 0 0.5em rgb(9 11 26 / 0.9),
      0 0 1em rgb(9 11 26 / 0.8);
  }
  .host {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    width: fit-content;
    font-size: 0.875rem;
    color: var(--muted);
    transition: color 0.4s;
  }
  [data-lit] .host {
    color: var(--neon-magenta);
  }

  @media (prefers-reduced-motion: reduce) {
    [data-lit] .sign-spill {
      animation: none;
    }
    .drip {
      display: none;
    }
  }
</style>

<script>
  for (const floor of document.querySelectorAll<HTMLElement>(
    "[data-attention]",
  )) {
    let inMiddle = false;
    let focused = false;
    const light = () => floor.toggleAttribute("data-lit", inMiddle || focused);

    // Any part of its Caption in the middle 30% of the screen.
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) inMiddle = entry.isIntersecting;
        light();
      },
      { rootMargin: "-35% 0px" },
    );
    for (const caption of floor.querySelectorAll("[data-caption]")) {
      observer.observe(caption);
    }

    // A key press after a click makes the focus a keyboard one too.
    const attend = () => {
      focused = floor.querySelector(":focus-visible") !== null;
      light();
    };
    floor.addEventListener("focusin", attend);
    floor.addEventListener("keyup", attend);
    floor.addEventListener("focusout", () => {
      focused = false;
      light();
    });
  }
</script>
