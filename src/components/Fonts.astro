---
// The site's fonts, declared in astro.config.ts. Rendered in the <head> of
// every document, including the Open Graph page, which has its own <html>.
import { Font } from "astro:assets";
---

<Font
  cssVariable="--font-commit-mono"
  preload={[{ weight: 400, style: "normal", subset: "latin" }]}
/>
<Font
  cssVariable="--font-michroma"
  preload={[{ weight: 400, style: "normal", subset: "latin" }]}
/>
