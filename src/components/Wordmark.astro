---
/**
 * The `eugen` / `codes` identity lockup as a neon sign: `eugen` is a heavy
 * magenta block with horizontal cutouts creeping in from the bottom, and
 * `codes` is a cyan neon script tilted beneath it. Everything is real text
 * sized in `em`, so the lockup scales with its font size.
 */
interface Props {
  class?: string;
}
const { class: className, ...rest } = Astro.props;
---

<h1 {...rest} class:list={["leading-none", className]}>
  <span class="sr-only">eugen.codes</span>
  <span aria-hidden="true" class="flex flex-col items-center">
    <span class="block-word relative inline-block font-display whitespace-nowrap text-magenta">
      <span class="block-glow absolute inset-0">eugen</span>
      <span class="block-fill relative">eugen</span>
    </span>
    <span class="script-word relative font-script whitespace-nowrap">
      codes
    </span>
  </span>
</h1>

<style>
  .block-word {
    letter-spacing: 0.02em;
  }
  /* The glow lives on an unmasked copy beneath so the cutouts don't slice it. */
  .block-glow {
    color: transparent;
    text-shadow:
      0 0 0.04em color-mix(in oklab, var(--magenta) 90%, white),
      0 0 0.18em color-mix(in oklab, var(--magenta) 70%, transparent),
      0 0 0.5em color-mix(in oklab, var(--magenta) 45%, transparent),
      0 0 1.2em color-mix(in oklab, var(--magenta) 25%, transparent);
  }
  /* Solid at the top, horizontal line cutouts creeping in from the bottom. */
  .block-fill {
    mask-image:
      linear-gradient(to bottom, black 40%, transparent 92%),
      repeating-linear-gradient(
        to bottom,
        black 0 0.045em,
        transparent 0.045em 0.075em
      );
    mask-composite: add;
  }
  .script-word {
    font-size: 0.6em;
    line-height: 1;
    margin-top: -0.25em;
    padding: 0 0.3em 0.2em;
    transform: rotate(-5deg);
    color: color-mix(in oklab, var(--cyan) 55%, white);
    text-shadow:
      0 0 0.03em white,
      0 0 0.08em var(--cyan),
      0 0 0.25em var(--cyan),
      0 0 0.7em color-mix(in oklab, var(--cyan) 60%, transparent);
  }
</style>
