---
import { socialLinks } from "@/site";
---

<footer class="flex flex-wrap items-center justify-between gap-x-4 gap-y-2 border-t pt-8 text-sm text-muted">
  {socialLinks.map((link) => (
    <a href={link.url} class="inline-flex items-center gap-2 hover:text-cyan">
      {link.displayUrl}
    </a>
  ))}
</footer>
