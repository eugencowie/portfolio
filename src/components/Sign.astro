---
import { twoLineWidth } from "@/lib/sign";

/**
 * A name on the Highrise as magenta Neon tubes: set in lowercase Michroma at
 * the font size it inherits, or, made to `fit`, shrunk from there until it
 * fits the nearest size container's width on two lines at most. Dark glass at
 * rest, flickering on while the Floor it is on is lit (`--floor-lit`), or
 * while a `[data-hover-lit]` ancestor is hovered with a mouse. Each letter
 * of the lit layer is its own span, and now and then one of a lit Sign buzzes;
 * a `failing` Sign has one letter that keeps cutting out. Both layers share one
 * grid cell and the same words, so they wrap alike.
 */
interface Props {
  text: string;
  /** Shrink to fit the nearest size container on two lines at most. */
  fit?: boolean;
  failing?: boolean;
}
const { text, fit = false, failing = false } = Astro.props;
const style = fit ? `--sign-width: ${twoLineWidth(text)}` : undefined;

const words = text.split(" ").map((word) => [...word]);
const failingAt = failing ? Math.floor(words.flat().length * 0.62) : -1;
let at = 0;
---

<span class:list={["sign", { fit }]} style={style} data-sign>
  <span class="unlit">
    {words.map((word, i) => (
      <>
        {i > 0 && " "}
        <span class="word">{word.join("")}</span>
      </>
    ))}
  </span>
  <span class="lit" aria-hidden="true">
    {words.map((word, i) => (
      <>
        {i > 0 && " "}
        <span class="word">
          {word.map((letter) => (
            <span data-letter data-failing={at++ === failingAt || undefined}>
              {letter}
            </span>
          ))}
        </span>
      </>
    ))}
  </span>
</span>

<style>
  .sign {
    display: grid;
    font-family: var(--font-name);
    text-transform: lowercase;
    letter-spacing: 0.01em;
    line-height: 1.12;
  }
  /* --sign-width is the name's width on at most two lines in em, and the 4%
     slack covers the letter-spacing. */
  .fit {
    font-size: min(1em, 100cqi * 0.96 / var(--sign-width));
  }
  .unlit,
  .lit {
    grid-area: 1 / 1;
  }
  .word {
    display: inline-block;
  }
  /* Unlit: dark glass. */
  .unlit {
    color: color-mix(in oklab, var(--magenta) 6%, transparent);
    -webkit-text-stroke: 1px
      color-mix(in oklab, var(--magenta) 55%, transparent);
    text-shadow: 0.02em 0.05em 0.04em rgb(0 0 0 / 0.6);
  }
  /* Lit: a pale core, a tight glow and an outer haze. */
  .lit {
    color: var(--neon-magenta);
    -webkit-text-stroke: 0.012em color-mix(in oklab, var(--magenta) 75%, white);
    text-shadow:
      0 0 0.02em white,
      0 0 0.06em var(--magenta),
      0 0 0.14em var(--magenta),
      0 0 0.3em var(--magenta),
      0 0 0.8em color-mix(in oklab, var(--magenta) 45%, transparent);
    opacity: var(--lit);
    transition: --lit 0.35s ease-out;
    pointer-events: none;
  }
  @container style(--floor-lit: 1) {
    .lit {
      --lit: 1;
      transition: --lit var(--neon-flicker, 0.35s ease-out);
    }
  }
  /* With a mouse only: on a touch screen a tapped one would stay lit. */
  @media (hover: hover) {
    :global([data-hover-lit]:hover) .lit {
      --lit: 1;
      transition: --lit var(--neon-flicker, 0.35s ease-out);
    }
  }
  /* Paused rather than removed as the Sign goes out, so a cut-out letter fades
     out with it, and carries on where it was once the Sign is lit again. */
  [data-failing] {
    opacity: var(--failing);
    animation: failing 4.7s steps(1) infinite paused;
  }
  @container style(--floor-lit: 1) {
    [data-failing] {
      animation-play-state: running;
    }
  }
  [data-letter][data-buzz] {
    animation: buzz 0.45s steps(1);
  }
  /* How lit a failing letter is. Animated in place of its opacity, like --lit:
     in Safari a paused opacity animation keeps a compositing layer. */
  @property --failing {
    syntax: "<number>";
    inherits: false;
    initial-value: 1;
  }
  @keyframes failing {
    0% {
      --failing: 1;
    }
    31% {
      --failing: 0.15;
    }
    33% {
      --failing: 1;
    }
    35% {
      --failing: 0.1;
    }
    41% {
      --failing: 0.9;
    }
    72% {
      --failing: 0.2;
    }
    73% {
      --failing: 1;
    }
    88% {
      --failing: 0.05;
    }
    96% {
      --failing: 1;
    }
  }
  @keyframes buzz {
    0% {
      opacity: 0.25;
    }
    20% {
      opacity: 1;
    }
    40% {
      opacity: 0.1;
    }
    60% {
      opacity: 0.8;
    }
    80% {
      opacity: 0.4;
    }
    100% {
      opacity: 1;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    [data-failing],
    [data-letter][data-buzz] {
      animation: none;
    }
  }
</style>

<script>
  const reducedMotion = matchMedia("(prefers-reduced-motion: reduce)");

  // Now and then a letter of a lit Sign buzzes. A Sign is lit on a lit Floor,
  // read from the flag rather than from whatever set it, or hovered.
  const lit = (sign: Element) =>
    getComputedStyle(sign).getPropertyValue("--floor-lit") === "1" ||
    sign.closest("[data-hover-lit]:hover") !== null;
  setInterval(() => {
    if (reducedMotion.matches || Math.random() > 0.45) return;
    const letters = [...document.querySelectorAll("[data-sign]")]
      .filter(lit)
      .flatMap((sign) => [
        ...sign.querySelectorAll<HTMLElement>(
          "[data-letter]:not([data-failing])",
        ),
      ]);
    const letter = letters[Math.floor(Math.random() * letters.length)];
    if (!letter) return;
    letter.removeAttribute("data-buzz");
    void letter.offsetWidth; // Restart the animation.
    letter.setAttribute("data-buzz", "");
  }, 1100);
</script>
