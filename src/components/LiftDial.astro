---
/**
 * A brass lift dial fixed in the corner of the screen from 64rem, its needle
 * sweeping from the top floor on the right to G on the left as the visitor
 * descends. It reads the `[data-floor]` numbers in its parent, easing
 * between two floors while their string course passes the middle of the
 * screen, and shows only while the parent fills the middle of the screen.
 */
interface Props {
  top: number;
}
const { top } = Astro.props;

const floors = Array.from({ length: top + 1 }, (_, n) => ({
  n,
  label: n === 0 ? "G" : String(n),
  // Round the arc from G at the left to the top floor at the right.
  x: (60 + 43 * Math.cos(Math.PI - (n / top) * Math.PI)).toFixed(2),
  y: (60 - 43 * Math.sin(Math.PI - (n / top) * Math.PI)).toFixed(2),
}));
---

<div class="lift" data-lift aria-hidden="true">
  <svg viewBox="0 0 120 72">
    <path class="face" d="M 6 64 A 54 54 0 0 1 114 64 Z"></path>
    <path class="arc" d="M 17 60 A 43 43 0 0 1 103 60" fill="none"></path>
    {floors.map(({ n, label, x, y }) => (
      <text x={x} y={y} data-dial={n}>
        {label}
      </text>
    ))}
    <g class="needle" data-needle>
      <line x1="60" y1="60" x2="60" y2="24"></line>
      <circle cx="60" cy="60" r="4"></circle>
    </g>
  </svg>
</div>

<style>
  .lift {
    position: fixed;
    right: 1rem;
    bottom: 1rem;
    z-index: 41;
    width: 11rem;
    opacity: 0;
    transition: opacity 0.5s;
    pointer-events: none;
    filter: drop-shadow(0 0.4rem 1rem rgb(0 0 0 / 0.6));
  }
  .lift[data-shown] {
    opacity: 1;
  }
  @media (max-width: 63.99rem) {
    .lift {
      display: none;
    }
  }
  .face {
    fill: #1b1422;
    stroke: #8a6a3a;
    stroke-width: 2.5;
  }
  .arc {
    stroke: #5a4628;
    stroke-width: 1;
  }
  text {
    font-family: var(--font-name);
    font-size: 8.5px;
    fill: #8a7456;
    text-anchor: middle;
    dominant-baseline: middle;
    transition: fill 0.2s;
  }
  text[data-on] {
    fill: #ffd28a;
    filter: drop-shadow(0 0 2px #ffb24a);
  }
  .needle {
    transform-origin: 60px 60px;
    stroke: #d9b87a;
    stroke-width: 1.6;
    fill: #8a6a3a;
  }
</style>

<script>
  function dial(lift: HTMLElement, building: HTMLElement) {
    const needle = lift.querySelector<SVGGElement>("[data-needle]");
    if (!needle) return;
    const labels = [...lift.querySelectorAll<SVGTextElement>("[data-dial]")];
    const floors = [...building.querySelectorAll<HTMLElement>("[data-floor]")];
    const number = (floor: HTMLElement) => Number(floor.dataset.floor);
    const top = Math.max(...floors.map(number));
    const still = matchMedia("(prefers-reduced-motion: reduce)");
    let target = top;
    let shown = top;
    let turning = false;

    // Where the lift is: a whole floor when that floor's middle is at the
    // middle of the screen, in between while passing a string course.
    const locate = () => {
      const middle = innerHeight / 2;
      let previous: { at: number; n: number } | undefined;
      for (const floor of floors) {
        const r = floor.getBoundingClientRect();
        const current = { at: r.top + r.height / 2, n: number(floor) };
        if (current.at >= middle) {
          if (!previous) return current.n;
          const t = (middle - previous.at) / (current.at - previous.at);
          return previous.n + t * (current.n - previous.n);
        }
        previous = current;
      }
      return previous?.n ?? top;
    };

    const turn = () => {
      shown += (target - shown) * (still.matches ? 1 : 0.14);
      if (Math.abs(target - shown) < 0.001) shown = target;
      // G points left, 90° anticlockwise from up; the top floor right.
      needle.style.transform = `rotate(${-90 + (shown / top) * 180}deg)`;
      const nearest = Math.round(shown);
      for (const label of labels) {
        label.toggleAttribute(
          "data-on",
          Number(label.dataset.dial) === nearest,
        );
      }
      turning = shown !== target;
      if (turning) requestAnimationFrame(turn);
    };

    let queued = false;
    const update = () => {
      queued = false;
      const r = building.getBoundingClientRect();
      const shows = r.top < innerHeight / 2 && r.bottom > innerHeight * 0.3;
      lift.toggleAttribute("data-shown", shows);
      if (!shows) return;
      target = locate();
      if (!turning) {
        turning = true;
        requestAnimationFrame(turn);
      }
    };
    const schedule = () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(update);
    };
    addEventListener("scroll", schedule, { passive: true });
    addEventListener("resize", schedule);
    schedule();
  }

  for (const lift of document.querySelectorAll<HTMLElement>("[data-lift]")) {
    if (lift.parentElement) dial(lift, lift.parentElement);
  }
</script>
