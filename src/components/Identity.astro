---
/**
 * The Avatar with the Wordmark beneath it: the Avatar is clipped at the
 * Wordmark's baseline, so `eugen` sits directly beneath it and `codes` below
 * that. Everything scales from `avatarWidth`, the Avatar's rendered width, as a
 * CSS length expression. The Hero and the Open Graph image both compose it.
 */
import { Image } from "astro:assets";
import avatar from "@/assets/avatar.png";
import Wordmark from "./Wordmark.astro";

interface Props {
  avatarWidth: string;
}
const { avatarWidth } = Astro.props;
---

<div class="identity relative flex w-full flex-col items-center">
  <Image
    src={avatar}
    alt="Illustrated portrait of Eugen: long hair, beard, aviator sunglasses, lit magenta on one side and cyan on the other."
    width={416}
    layout="constrained"
    widths={[272, 352, 416, 544, 704, 832]}
    sizes={avatarWidth}
    priority
    class="avatar h-auto select-none"
  />
  <div class="wordmark relative w-full">
    <Wordmark class="relative w-full text-center" />
  </div>
</div>

<style define:vars={{ "avatar-width": avatarWidth }}>
  /* Clip geometry, all in proportion to --avatar-width.
     --overlap: how far the Wordmark rises into the avatar.
     --wm: the Wordmark font size, chosen so `eugen` spans the Avatar's width
       (--avatar-width divided by the block's width per em, 2.58 for Anton
       with 0.02em letter-spacing).
     --baseline: Anton's baseline as a fraction of a line-height-1 box,
       0.5 + (ascent - descent) / (2 * upm) from the hhea table
       (ascent 2409, descent 674, upm 2048 => 0.924). */
  .identity {
    --overlap: calc(var(--avatar-width) * 0.27);
    --wm: calc(var(--avatar-width) / 2.58);
    --baseline: 0.924;
    --wm-baseline: calc(var(--wm) * var(--baseline));
  }
  .avatar {
    width: var(--avatar-width);
    clip-path: inset(0 0 calc(var(--overlap) - var(--wm-baseline)) 0);
  }
  .wordmark {
    font-size: var(--wm);
    margin-top: calc(-1 * var(--overlap));
  }
</style>
