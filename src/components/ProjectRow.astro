---
import { ArrowUpRight } from "@lucide/astro";
import type { ProjectEntry } from "@/lib/projects";

interface Props {
  project: ProjectEntry;
}
const { project } = Astro.props;
const { name, tagline, href } = project.data;
---

<li class="card relative grid grid-cols-[1fr_auto] items-baseline gap-x-4 gap-y-1 border-b py-4 last:border-b-0 sm:grid-cols-[auto_1fr_auto]">
  <h3 class="font-bold">
    <a
      href={href}
      class="after:absolute after:inset-0 after:content-[''] card-active:text-magenta"
    >
      {name}
    </a>
  </h3>
  <ArrowUpRight
    class="size-4 self-center text-muted sm:order-last card-active:text-magenta"
    aria-hidden="true"
  />
  <p class="col-span-2 min-w-0 text-sm text-muted sm:col-span-1 sm:truncate">
    {tagline}
  </p>
</li>
