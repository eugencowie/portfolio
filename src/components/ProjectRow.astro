---
import { ArrowUpRight } from "@lucide/astro";
import type { ProjectEntry } from "@/lib/projects";
import GithubIcon from "./GithubIcon.astro";

interface Props {
  project: ProjectEntry;
}
const { project } = Astro.props;
const { name, tagline, liveUrl, repoUrl, href } = project.data;
---

<li class="group relative grid grid-cols-[1fr_auto] items-baseline gap-x-4 gap-y-1 border-b py-4 last:border-b-0 sm:grid-cols-[auto_1fr_auto]">
  <h3 class="font-bold">
    <a
      href={href}
      class="group-hover:text-cyan after:absolute after:inset-0 after:content-['']"
    >
      {name}
    </a>
  </h3>
  <span class="flex items-center gap-3 self-center text-muted sm:order-last">
    {liveUrl && repoUrl ? (
      <a
        href={repoUrl}
        aria-label={`${name} on GitHub`}
        class="relative z-10 hover:text-cyan"
      >
        <GithubIcon class="size-4" />
      </a>
    ) : repoUrl ? (
      <GithubIcon class="size-4" />
    ) : null}
    <ArrowUpRight class="size-4 group-hover:text-cyan" aria-hidden="true" />
  </span>
  <p class="col-span-2 min-w-0 text-sm text-muted sm:col-span-1 sm:truncate">
    {tagline}
  </p>
</li>
