---
import type { ProjectEntry } from "@/lib/projects";

/**
 * One Other Project. Rendered inside a `<ul class="grid">` with a name column
 * and a tagline column; the row uses subgrid so every name column shares one
 * width and the taglines line up like a directory listing.
 */
interface Props {
  project: ProjectEntry;
}
const { project } = Astro.props;
const { name, tagline, href } = project.data;
---

<li class="card relative col-span-full grid grid-cols-subgrid items-baseline gap-x-6 gap-y-1 py-2">
  <h3 class="font-bold">
    <a
      href={href}
      class="after:absolute after:inset-0 after:content-[''] card-active:text-magenta"
    >
      {name}
    </a>
  </h3>
  <p class="min-w-0 text-sm text-muted">{tagline}</p>
</li>
