---
import type { ProjectEntry } from "@/lib/projects";
import SectionHeading from "./SectionHeading.astro";
import ProjectRow from "./ProjectRow.astro";

/**
 * The Other Section rendered as compact rows: names in one column, taglines
 * in the next, stacked on narrow viewports. Renders nothing when the Section
 * is empty.
 */
interface Props {
  id: string;
  projects: ProjectEntry[];
}
const { id, projects } = Astro.props;
---

{projects.length > 0 && (
  <section aria-labelledby={id} class="mx-6 flex flex-col gap-6">
    <SectionHeading id={id}>
      <slot />
    </SectionHeading>
    <ul class="grid grid-cols-1 gap-y-3 sm:grid-cols-[auto_1fr] sm:gap-y-0">
      {projects.map((project) => (
        <ProjectRow project={project} />
      ))}
    </ul>
  </section>
)}
