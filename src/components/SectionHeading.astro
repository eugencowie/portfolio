---
/** A Section's heading in cyan Neon, humming: now and then it dips. */
interface Props {
  id: string;
}
const { id } = Astro.props;
---

<h2
  id={id}
  class="neon font-script text-4xl leading-none lowercase sm:text-5xl"
>
  <slot />
</h2>

<style>
  .neon {
    color: var(--neon-cyan);
    text-shadow: var(--neon-cyan-glow);
    animation: hum 9s steps(1) infinite;
  }
  @keyframes hum {
    0%,
    100% {
      opacity: 1;
    }
    61% {
      opacity: 0.55;
    }
    61.6% {
      opacity: 1;
    }
    62.4% {
      opacity: 0.4;
    }
    63% {
      opacity: 1;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .neon {
      animation: none;
    }
  }
</style>
