---
import Identity from "./Identity.astro";
import Skyline from "./Skyline.astro";
import { socialLinks } from "@/site";

/** The space between the Hero and the viewport's sides. */
const gutter = "1.5rem";

/** The Avatar's width, capped by the viewport width and height so the whole
 * Hero, Social Links included, fits on one screen from a landscape phone up to
 * a desktop monitor. */
const avatarWidth = `min(26rem, 100vw - 2 * ${gutter}, 48svh)`;
---

<!--
  The Hero is the one full-bleed Scene on the home page: it fills the first
  screen, with the Skyline standing at its foot and scrolling away with it.
-->
<header class="hero relative isolate flex min-h-svh flex-col items-center text-center">
  <Skyline dissolve />
  <Identity avatarWidth={avatarWidth} />
  <p class="social-links flex flex-wrap justify-center gap-x-6 gap-y-2 text-lg text-foreground sm:text-xl">
    {socialLinks.map((link) => (
      <a href={link.url} class="hover:text-magenta">
        {link.label}
      </a>
    ))}
  </p>
</header>

<style define:vars={{ gutter }}>
  .hero {
    padding-block-start: var(--page-block-inset);
    padding-inline: var(--gutter);
  }
  /* The Social Links often land on the rooftops, so they get a dark halo to
     stay legible against the neon. */
  .social-links {
    margin-top: clamp(1.5rem, 6svh, 5rem);
    text-shadow:
      0 0 0.5em var(--background),
      0 0 1em var(--background);
  }
</style>
