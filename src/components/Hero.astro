---
import { Image } from "astro:assets";
import avatar from "@/assets/avatar.png";
import Wordmark from "./Wordmark.astro";

interface Props {
  tagline: string;
}
const { tagline } = Astro.props;
---

<header class="flex flex-col items-center text-center">
  {/*
    The Avatar is clipped at the Wordmark's baseline, so `eugen` sits directly
    beneath it and `codes` below that. The maths lives in `--overlap`, `--wm`
    and `--baseline` in <style>.
  */}
  <div class="hero-stack relative flex w-full flex-col items-center">
    <Image
      src={avatar}
      alt="Illustrated portrait of Eugen: long hair, beard, aviator sunglasses, lit magenta on one side and cyan on the other."
      width={416}
      layout="constrained"
      widths={[272, 352, 416, 544, 704, 832]}
      sizes="(min-width: 40rem) 416px, (min-width: 400px) 352px, calc(100vw - 48px)"
      priority
      class="avatar h-auto w-88 max-w-full select-none sm:w-104"
    />
    <div class="wordmark relative w-full">
      <Wordmark class="relative w-full text-center" />
    </div>
  </div>
  <p class="mt-20 max-w-xl text-lg text-muted sm:text-xl">{tagline}</p>
</header>

<style>
  /* Clip geometry.
     --overlap: how far the Wordmark rises into the avatar.
     --wm: the Wordmark font size.
     --baseline: Michroma's baseline as a fraction of a line-height-1 box
       (ascent 2368, descent 544, upm 2048 => 0.945). */
  .hero-stack {
    --overlap: 5.5rem;
    --wm: 4.5rem;
    --baseline: 0.945;
    --wm-baseline: calc(var(--wm) * var(--baseline));
  }
  @media (min-width: 40rem) {
    .hero-stack {
      --overlap: 7.5rem;
      --wm: 6rem;
    }
  }
  .wordmark {
    font-size: var(--wm);
    margin-top: calc(-1 * var(--overlap));
  }
  .avatar {
    clip-path: inset(0 0 calc(var(--overlap) - var(--wm-baseline)) 0);
  }
</style>
