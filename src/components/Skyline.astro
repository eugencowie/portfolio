---
/**
 * The neon skyline at the foot of the Scene it stands in, the Hero or the
 * Open Graph image, filling the Scene behind its content. The parent must be
 * `relative isolate`: the Skyline sits at `-z-10` inside that stacking
 * context, which keeps it behind the content but in front of the fixed Sky.
 * It scales with the viewport width and sinks so only a sliver of the river
 * reflection stays visible. With `dissolve`, that sliver fades into the Sky,
 * so a page scrolling past the Scene lands on plain sky. The rooftops fade in
 * from the top so copy stays readable where the two overlap on short
 * viewports.
 */
import { Image } from "astro:assets";
import skyline from "@/assets/skyline.png";

interface Props {
  /** Fade the visible river out at the bottom, into the Sky behind. */
  dissolve?: boolean;
}
const { dissolve = false } = Astro.props;
---

<div
  aria-hidden="true"
  class:list={[
    "scene pointer-events-none absolute inset-0 -z-10 overflow-hidden select-none",
    { dissolve },
  ]}
>
  <Image
    src={skyline}
    alt=""
    widths={[960, 1280, skyline.width]}
    sizes="(min-width: 48rem) 100vw, 48rem"
    loading="eager"
    class="skyline absolute left-1/2 h-auto max-w-none -translate-x-1/2"
  />
</div>

<style define:vars={{ aspect: skyline.height / skyline.width }}>
  /* The Scene glows magenta at the horizon. */
  .scene {
    --reflection-shown: 10svh;
    background: radial-gradient(
      ellipse 90% 45% at 50% 100%,
      color-mix(in oklab, var(--magenta) 40%, transparent),
      transparent 70%
    );
  }
  /* The visible river, glow included, runs out into the Sky behind it. */
  .dissolve {
    mask-image: linear-gradient(
      to bottom,
      black calc(100% - var(--reflection-shown)),
      transparent
    );
  }
  /* Image geometry as fractions of its height: sky ends at the tallest tower
     (0.30), the waterline sits at 0.66 and the reflection fills the rest.
     --aspect is height over width, taken from the image itself. */
  .skyline {
    /* Never narrower than this, so phones get a centred crop rather than a strip. */
    --width: max(100vw, 48rem);
    --reflection: calc(var(--width) * var(--aspect) * 0.34);
    width: var(--width);
    bottom: min(0px, calc(var(--reflection-shown) - var(--reflection)));
    opacity: 0.55;
    mask-image: linear-gradient(to bottom, transparent 30%, black 66%);
  }
  /* On short viewports the towers would reach the top of the screen; fade
     them harder so they stay a horizon behind the Identity rather than a wall. */
  @media (max-height: 35rem) {
    .skyline {
      opacity: 0.35;
      mask-image: linear-gradient(to bottom, transparent 50%, black 75%);
    }
  }
</style>
