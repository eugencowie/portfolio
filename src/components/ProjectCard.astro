---
import { Image } from "astro:assets";
import { ArrowUpRight } from "@lucide/astro";
import type { CardProjectEntry } from "@/lib/projects";

interface Props {
  project: CardProjectEntry;
}
const { project } = Astro.props;
const { name, tagline, screenshot, featured, href } = project.data;

/**
 * The two card designs. The Featured Project spans both grid columns of its
 * Card Section; every other Project shares them.
 */
const FEATURED = {
  article: "gap-5 sm:col-span-2",
  widths: [640, 960, 1280, 1800],
  sizes: "(min-width: 56rem) 848px, 100vw",
  body: "gap-3",
  name: "text-3xl leading-none sm:text-4xl",
  tagline: "text-lg",
  host: "text-sm",
  icon: "size-4",
};
const STANDARD = {
  article: "gap-4",
  widths: [480, 800, 1200],
  sizes:
    "(min-width: 56rem) 412px, (min-width: 40rem) calc(50vw - 36px), 100vw",
  body: "gap-2",
  name: "text-lg",
  tagline: "text-sm",
  host: "pt-1 text-xs",
  icon: "size-3.5",
};
const variant = featured ? FEATURED : STANDARD;
---

<article class:list={["card relative flex flex-col", variant.article]}>
  <Image
    src={screenshot}
    alt={`Screenshot of ${name}`}
    widths={variant.widths}
    sizes={variant.sizes}
    loading="lazy"
    class="aspect-video w-full object-cover"
  />
  <div class:list={["flex flex-col", variant.body]}>
    <h3 class:list={["font-name lowercase", variant.name]}>
      <a
        href={href}
        class="after:absolute after:inset-0 after:content-[''] card-active:text-magenta"
      >
        {name}
      </a>
    </h3>
    <p class:list={["text-muted", variant.tagline]}>{tagline}</p>
    <p class:list={["flex items-center gap-1 text-muted", variant.host]}>
      {new URL(href).host}
      <ArrowUpRight class={variant.icon} aria-hidden="true" />
    </p>
  </div>
</article>
