---
import { Image } from "astro:assets";
import { ArrowUpRight } from "@lucide/astro";
import type { CardProjectEntry } from "@/lib/projects";
import GithubIcon from "./GithubIcon.astro";

interface Props {
  project: CardProjectEntry;
}
const { project } = Astro.props;
const { name, tagline, liveUrl, repoUrl, screenshot, featured, href } =
  project.data;
---

<article
  class:list={[
    "group relative flex overflow-hidden rounded-lg border bg-surface transition-colors focus-within:border-magenta hover:border-magenta",
    featured ? "flex-col sm:col-span-2 md:flex-row" : "flex-col",
  ]}
>
  <Image
    src={screenshot}
    alt={`Screenshot of ${name}`}
    widths={[480, 800, 1200]}
    sizes={
      featured
        ? "(min-width: 768px) 560px, 100vw"
        : "(min-width: 640px) 440px, 100vw"
    }
    class:list={[
      "aspect-[16/10] w-full object-cover",
      featured && "md:w-3/5 md:border-r",
      !featured && "border-b",
    ]}
  />
  <div class="flex flex-1 flex-col gap-2 p-5">
    <div class="flex items-start justify-between gap-4">
      <h3 class:list={["font-bold", featured ? "text-2xl" : "text-lg"]}>
        <a
          href={href}
          class="group-hover:text-magenta after:absolute after:inset-0 after:content-['']"
        >
          {name}
        </a>
      </h3>
      {liveUrl && repoUrl && (
        <a
          href={repoUrl}
          aria-label={`${name} on GitHub`}
          class="relative z-10 shrink-0 text-muted hover:text-magenta"
        >
          <GithubIcon class="size-5" />
        </a>
      )}
    </div>
    <p class="text-sm text-muted">{tagline}</p>
    <p class="mt-auto flex items-center gap-1 pt-3 text-xs text-muted">
      {liveUrl ? new URL(liveUrl).host : "github.com"}
      <ArrowUpRight class="size-3.5" aria-hidden="true" />
    </p>
  </div>
</article>
